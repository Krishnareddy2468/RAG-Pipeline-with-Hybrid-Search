# --- LLM Provider ---
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# --- Vector Store ---
CHROMA_PERSIST_DIR=data/indexes/chroma
CHROMA_COLLECTION_NAME=internal_docs

# --- Sparse (BM25) Index ---
BM25_INDEX_PATH=data/indexes/bm25_index.pkl

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHUNKING_STRATEGY=recursive
DEDUPE_SIMILARITY_THRESHOLD=0.95

# --- Hybrid Retrieval ---
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_K=60
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RERANK_CANDIDATES=20
RERANK_TOP_N=5

# --- Generation / Confidence ---
MIN_RETRIEVAL_CONFIDENCE=0.5
MIN_ANSWER_CONFIDENCE=0.6

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Dashboard ---
DASHBOARD_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO
