# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Testing / linting / type-checking ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS ---
.DS_Store
Thumbs.db

# --- Editors ---
.vscode/
.idea/

# --- Local-only working notes (day-by-day plan, AI-assisted scratch notes) ---
