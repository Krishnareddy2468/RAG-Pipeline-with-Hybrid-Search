docs/

# --- Reference material (purchased/received guide, not project source) ---
BASWE__15_AI_Engineering_Projects_Guide.docx

# --- Derived/regenerable data (rebuilt by the ingestion/indexing pipeline) ---
data/processed/*
!data/processed/.gitkeep
data/indexes/*
!data/indexes/.gitkeep

# --- Local runtime artifacts ---
*.log
*.sqlite3
